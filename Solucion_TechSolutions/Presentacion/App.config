<?xml version="1.0" encoding="utf-8" ?>
<!-- Va en el proyecto Presentacion (proyecto de inicio).
     Cambie Data Source según su servidor:  .\SQLEXPRESS (SQL Server Express)  ·  . o (local) (Developer)  ·  (localdb)\MSSQLLocalDB
     Se usa Integrated Security (autenticación de Windows): NO hay usuario ni contraseña escritos en este archivo. -->
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <!-- Minutos sin actividad (mouse/teclado) antes de cerrar la sesión automáticamente. Para probar rápido, use 1. -->
    <add key="MinutosInactividad" value="5" />
  </appSettings>
  <connectionStrings>
    <add name="TechSolutions"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=TechSolutions;Integrated Security=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
